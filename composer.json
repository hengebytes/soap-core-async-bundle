{
    "name": "hengebytes/soap-core-async-bundle",
    "type": "symfony-bundle",
    "description": "Symfony bundle for using http client as soap async client",
    "keywords": [
        "ASYNC HTTP Client",
        "PHP Soap",
        "Symfony",
        "Bundle"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "hengebytes/webservice-core-async-bundle": "^1.3.0",
        "php-http/discovery": "^1.20",
        "php-soap/engine": "^2.20",
        "php-soap/encoding": "0.35.0",
        "php-soap/psr18-transport": "^2.1",
        "php-soap/wsdl": "^1.22",
        "php-soap/wsdl-reader": "^0.33",
        "php-soap/xml": "^1.11",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "veewee/reflecta": "^1.0",
        "veewee/xml": "^4.13"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.4"
    },
    "autoload": {
        "psr-4": {
            "Hengebytes\\SoapCoreAsyncBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hengebytes\\SoapCoreAsyncBundle\\Tests\\": "tests/"
        }
    }
}
